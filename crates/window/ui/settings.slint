import { Button, CheckBox, ComboBox, LineEdit, SpinBox, Slider, ScrollView, GroupBox, ListView } from "std-widgets.slint";

// Colours by role; the window sets them from the chosen theme (see themes.rs).
export global Palette {
    in-out property <color> background: #121216;
    in-out property <color> card: #1b1b21;
    in-out property <color> centre: #2a2a32;
    in-out property <color> centre-hover: #2f2f38;
    in-out property <color> track: #34343e;
    in-out property <color> button: #26262e;
    in-out property <color> button-hover: #30303a;
    in-out property <color> edge: #3a3a44;
    in-out property <color> text: #f2f2f5;
    in-out property <color> text-strong: #ffffff;
    in-out property <color> text-dim: #c4c4ce;
    in-out property <color> subtle: #a8a8b4;
    in-out property <color> faint: #8e8e9a;
    in-out property <color> hint: #6e6e7a;
    in-out property <color> list: #18181d;
    in-out property <color> selected: #264a32;
    in-out property <color> selected-hover: #2f5a3c;
    in-out property <color> check: #6ee08a;
    in-out property <color> ok: #5cc878;
    in-out property <color> held: #4a3818;
    in-out property <color> held-edge: #e0a040;
    in-out property <color> held-text: #ffd38a;
}

// How the window lays out the knobs (Settings > Look; the same options as the panel widget).
export global Look {
    in-out property <float> scale: 1.0;
    // 0 knobs (dials), 1 sliders (compact list), 2 faders (vertical, like a mixing desk)
    in-out property <int> style;
    in-out property <bool> show-name: true;
    in-out property <bool> show-percent: true;
    in-out property <bool> show-source: true;
    in-out property <bool> show-button: true;
    in-out property <bool> show-action-labels: true;
    in-out property <bool> buttons-in-dial;
    in-out property <bool> show-header: true;
}

export struct AppRow {
    name: string,
    selected: bool,
    playing: bool,
    // other knobs that have it
    elsewhere: string,
}

// Choices the pages offer, filled in by the window from the service.
export global Lists {
    in property <[string]> knob-names;
    in property <[string]> playing;
    in property <[string]> actions;
    // Home Assistant: "(none)" first, then friendly names; the window maps the index back to an entity id.
    in property <[string]> lights;
    in property <[string]> toggles;
    in property <[string]> profiles;
    in property <[string]> amounts;
    in property <[color]> swatches;
    in property <[string]> swatch-hex;
    in property <bool> home-assistant;
    pure callback parse-color(string) -> color;
}

// The knob (and its button) being edited.
export global KnobSettings {
    in-out property <int> index;
    in-out property <string> name;
    in-out property <[string]> apps;
    // 0 = apps, 1 = output volume, 2 = Home Assistant light
    in-out property <int> kind;
    in-out property <bool> catch-all;
    in-out property <int> light-index;
    in-out property <int> min;
    in-out property <int> max;
    in-out property <string> color;
    in-out property <string> background;
    in-out property <string> muted-color;
    in-out property <int> press-kind;
    in-out property <int> press-entity;
    in-out property <int> hold-kind;
    in-out property <int> hold-entity;
    in-out property <[AppRow]> app-rows;
    // collapsed: only this knob's apps; expanded: every app
    in-out property <bool> apps-expanded;
    // how many apps the full list has
    in-out property <int> app-total;
    callback set-apps-expanded(bool);
    callback add-app(string);
    callback toggle-app(int);
    callback remove-knob();
}

export global General {
    in-out property <bool> popups;
    // 0 automatic, 1 Atoll island, 2 KDE, 3 notifications
    in-out property <int> popup-style;
    in-out property <int> theme-index;
    // Look (the window's layout), previewed live
    in-out property <int> look-style;
    in-out property <float> look-scale: 100;
    in-out property <bool> look-show-name: true;
    in-out property <bool> look-show-percent: true;
    in-out property <bool> look-show-source: true;
    in-out property <bool> look-show-button: true;
    in-out property <bool> look-show-action-labels: true;
    in-out property <bool> look-buttons-in-dial;
    in-out property <bool> look-show-header: true;
    in-out property <[bool]> look-shown;
    callback look-changed();
    callback toggle-shown(int);
    callback add-knob();
    callback open-devices();
    in property <[string]> theme-names;
    callback theme-changed(int);
    in-out property <float> brightness;
    in-out property <bool> dim-idle;
    // LED calibration: per-channel correction for dimming
    in-out property <float> gamma-red: 1.0;
    in-out property <float> gamma-green: 1.0;
    in-out property <float> gamma-blue: 1.0;
    callback gamma-changed();
    callback open-calibration();
    in-out property <bool> auto-enabled;
    in-out property <[bool]> lower;
    in-out property <[bool]> triggers;
    in-out property <bool> voice-chat;
    in-out property <int> amount-index;
    in-out property <bool> auto-dim;
    in-out property <string> ha-url;
    in-out property <string> ha-token;
    in-out property <int> profile-index;
    in-out property <string> profile-name;
    in-out property <string> current-version: "v0.1.0";
    in-out property <string> latest-version: "";
    in-out property <string> update-status: "Up to date";
    in-out property <bool> update-available: false;
    in-out property <bool> checking-update: false;
    in-out property <bool> updating: false;
    callback toggle-lower(int);
    callback toggle-trigger(int);
    callback switch-profile(int);
    callback new-profile();
    callback rename-profile(string);
    callback delete-profile();
    callback edit-file();
    callback check-update();
    callback apply-update();
}

component Label inherits Text {
    color: Palette.text-dim;
    vertical-alignment: center;
}

component Hint inherits Text {
    color: Palette.faint;
    font-size: 12px;
    wrap: word-wrap;
}

component ColorPicker inherits VerticalLayout {
    in property <string> label;
    in-out property <string> value;
    spacing: 6px;
    HorizontalLayout {
        spacing: 8px;
        Label { text: root.label; width: 110px; }
        Rectangle {
            width: 28px;
            height: 28px;
            border-radius: 6px;
            border-width: 1px;
            border-color: Palette.edge;
            background: Lists.parse-color(root.value);
        }
        LineEdit {
            text <=> root.value;
            width: 110px;
        }
    }
    HorizontalLayout {
        spacing: 4px;
        padding-left: 118px;
        alignment: start;
        for swatch[i] in Lists.swatches: Rectangle {
            width: 20px;
            height: 20px;
            border-radius: 4px;
            background: swatch;
            border-width: Lists.swatch-hex[i] == root.value ? 2px : 0px;
            border-color: Palette.text-strong;
            TouchArea {
                clicked => { root.value = Lists.swatch-hex[i]; }
            }
        }
    }
}

component ActionPicker inherits HorizontalLayout {
    in property <string> label;
    in-out property <int> kind;
    in-out property <int> entity;
    spacing: 8px;
    Label { text: root.label; width: 110px; }
    ComboBox {
        model: Lists.actions;
        current-index <=> root.kind;
        width: 230px;
    }
    // the last two actions are Home Assistant toggle / turn off
    if root.kind >= Lists.actions.length - 2: ComboBox {
        model: Lists.toggles;
        current-index <=> root.entity;
        horizontal-stretch: 1;
    }
}

export component KnobPage inherits ScrollView {
    VerticalLayout {
        padding: 4px;
        spacing: 14px;
        alignment: start;

        GroupBox {
            title: "Knob";
            VerticalLayout {
                spacing: 10px;
                HorizontalLayout {
                    spacing: 8px;
                    Label { text: "Name"; width: 110px; }
                    LineEdit { text <=> KnobSettings.name; placeholder-text: "Knob " + (KnobSettings.index + 1); }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Label { text: "Controls"; width: 110px; }
                    ComboBox {
                        model: Lists.home-assistant
                            ? ["Apps", "Output volume (everything)", "A Home Assistant light"]
                            : ["Apps", "Output volume (everything)"];
                        current-index <=> KnobSettings.kind;
                    }
                }
            }
        }

        if KnobSettings.kind == 0: GroupBox {
            title: "Apps on this knob";
            VerticalLayout {
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    Hint {
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        text: KnobSettings.apps.length == 0
                            ? "Click apps to put them on this knob. Apps you've played show up here."
                            : KnobSettings.apps.length + " on this knob. Click an app to add it or take it off.";
                    }
                    Button {
                        text: KnobSettings.apps-expanded ? "▴ Show only this knob's" : "▾ Show all apps (" + KnobSettings.app-total + ")";
                        clicked => { KnobSettings.set-apps-expanded(!KnobSettings.apps-expanded); }
                    }
                }
                Rectangle {
                    // the window hands the list only the rows to show; every row keeps its height
                    height: min(300px, KnobSettings.app-rows.length * 40px + 8px);
                    visible: KnobSettings.app-rows.length > 0;
                    animate height { duration: 160ms; easing: ease-out; }
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Palette.track;
                    background: Palette.list;
                    ListView {
                        for row[i] in KnobSettings.app-rows: Rectangle {
                            height: 40px;
                            // the highlight is inset so neighbouring rows read as separate pills
                            Rectangle {
                                x: 4px;
                                y: 2px;
                                width: parent.width - 8px;
                                height: parent.height - 4px;
                                border-radius: 6px;
                                background: row.selected
                                    ? (pick.has-hover ? Palette.selected-hover : Palette.selected)
                                    : (pick.has-hover ? Palette.centre : transparent);
                            }
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 12px;
                                spacing: 10px;
                                Text {
                                    text: row.selected ? "✓" : "";
                                    width: 16px;
                                    color: Palette.check;
                                    font-weight: 800;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: row.name;
                                    color: row.selected ? Palette.text-strong : Palette.text-dim;
                                    font-weight: row.selected ? 600 : 400;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                if row.playing: Text {
                                    text: "playing now";
                                    color: Palette.check;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                                if row.elsewhere != "": Text {
                                    text: "on " + row.elsewhere;
                                    color: Palette.faint;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                            }
                            pick := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { KnobSettings.toggle-app(i); }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    typed := LineEdit {
                        placeholder-text: "Or type an app or program name";
                        horizontal-stretch: 1;
                        accepted(text) => {
                            KnobSettings.add-app(text);
                            self.text = "";
                        }
                    }
                    Button {
                        text: "Add";
                        clicked => {
                            KnobSettings.add-app(typed.text);
                            typed.text = "";
                        }
                    }
                }
                CheckBox {
                    text: "Also every app no other knob has";
                    checked <=> KnobSettings.catch-all;
                }
                Hint { text: "Voice chat and system sounds are never caught by \"every app\"."; }
            }
        }

        if KnobSettings.kind == 2: GroupBox {
            title: "Home Assistant light";
            VerticalLayout {
                spacing: 8px;
                ComboBox {
                    model: Lists.lights;
                    current-index <=> KnobSettings.light-index;
                }
                Hint { text: "The knob dims this light; all the way down turns it off."; }
            }
        }

        if KnobSettings.kind != 2: GroupBox {
            title: "Volume range";
            HorizontalLayout {
                spacing: 8px;
                Label { text: "From"; }
                SpinBox { minimum: 0; maximum: 100; value <=> KnobSettings.min; }
                Label { text: "% to"; }
                SpinBox { minimum: 0; maximum: 100; value <=> KnobSettings.max; }
                Label { text: "%"; }
            }
        }

        GroupBox {
            title: "Lights";
            VerticalLayout {
                spacing: 12px;
                ColorPicker { label: "Level"; value <=> KnobSettings.color; }
                ColorPicker { label: "Background"; value <=> KnobSettings.background; }
                ColorPicker { label: "Muted"; value <=> KnobSettings.muted-color; }
            }
        }

        HorizontalLayout {
            alignment: start;
            Button {
                text: "Remove this knob";
                enabled: Lists.knob-names.length > 1;
                clicked => { KnobSettings.remove-knob(); }
            }
        }
    }
}

export component ButtonPage inherits VerticalLayout {
    spacing: 14px;
    alignment: start;
    GroupBox {
        title: "Button";
        VerticalLayout {
            spacing: 12px;
            ActionPicker { label: "Press"; kind <=> KnobSettings.press-kind; entity <=> KnobSettings.press-entity; }
            ActionPicker { label: "Hold (½ s)"; kind <=> KnobSettings.hold-kind; entity <=> KnobSettings.hold-entity; }
            Hint {
                text: Lists.home-assistant
                    ? "Holding fires as soon as half a second has passed. \"Mute this knob\" also mutes apps that start later."
                    : "Holding fires as soon as half a second has passed. Set up Home Assistant in Settings to control lights and switches.";
            }
        }
    }
}

export component GeneralPage inherits ScrollView {
    VerticalLayout {
        padding: 4px;
        spacing: 14px;
        alignment: start;

        GroupBox {
            title: "Look";
            HorizontalLayout {
                spacing: 8px;
                Label { text: "Theme"; width: 110px; }
                ComboBox {
                    model: General.theme-names;
                    current-index <=> General.theme-index;
                    selected => { General.theme-changed(self.current-index); }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Label { text: "Style"; width: 110px; }
                ComboBox {
                    model: ["Knobs (dials)", "Sliders (compact list)", "Faders (like a mixing desk)"];
                    current-index <=> General.look-style;
                    selected => { General.look-changed(); }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Label { text: "Size"; width: 110px; }
                Slider {
                    minimum: 30;
                    maximum: 160;
                    value <=> General.look-scale;
                    released => { General.look-changed(); }
                }
                Label { text: round(General.look-scale) + "%"; width: 44px; }
            }
            Label { text: "Show:"; }
            HorizontalLayout {
                spacing: 12px;
                alignment: start;
                CheckBox { text: "Names"; checked <=> General.look-show-name; toggled => { General.look-changed(); } }
                CheckBox { text: "Percentages"; checked <=> General.look-show-percent; toggled => { General.look-changed(); } }
                CheckBox { text: "What's playing"; checked <=> General.look-show-source; toggled => { General.look-changed(); } }
            }
            HorizontalLayout {
                spacing: 12px;
                alignment: start;
                CheckBox { text: "Buttons"; checked <=> General.look-show-button; toggled => { General.look-changed(); } }
                CheckBox {
                    text: "What the buttons do";
                    enabled: General.look-show-button;
                    checked <=> General.look-show-action-labels;
                    toggled => { General.look-changed(); }
                }
                CheckBox { text: "Title bar"; checked <=> General.look-show-header; toggled => { General.look-changed(); } }
                CheckBox {
                    text: "Buttons inside the dials";
                    enabled: General.look-show-button && General.look-style == 0;
                    checked <=> General.look-buttons-in-dial;
                    toggled => { General.look-changed(); }
                }
            }
            Label { text: "Knobs in the window:"; }
            HorizontalLayout {
                spacing: 12px;
                alignment: start;
                for name[i] in Lists.knob-names: CheckBox {
                    text: name;
                    checked: General.look-shown[i];
                    toggled => { General.toggle-shown(i); }
                }
            }
        }

        GroupBox {
            title: "Knobs";
            VerticalLayout {
                spacing: 8px;
                Hint {
                    text: "This profile has " + Lists.knob-names.length + " knob" + (Lists.knob-names.length == 1 ? "" : "s")
                        + ". A mixer drives the first five; the rest work from this window, the panel widget and scripts.";
                }
                HorizontalLayout {
                    alignment: start;
                    Button {
                        text: "Add a knob";
                        enabled: Lists.knob-names.length < 16;
                        clicked => { General.add-knob(); }
                    }
                }
                Hint { text: "To remove a knob, right-click it and choose Remove this knob."; }
                HorizontalLayout {
                    alignment: start;
                    Button { text: "Devices… (keyboard knob, MIDI, deej)"; clicked => { General.open-devices(); } }
                }
            }
        }

        GroupBox {
            title: "Profiles";
            VerticalLayout {
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    Label { text: "Active"; width: 110px; }
                    ComboBox {
                        model: Lists.profiles;
                        current-index <=> General.profile-index;
                        selected => { General.switch-profile(self.current-index); }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Label { text: "Name"; width: 110px; }
                    LineEdit { text <=> General.profile-name; }
                    Button { text: "Rename"; clicked => { General.rename-profile(General.profile-name); } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    padding-left: 118px;
                    alignment: start;
                    Button { text: "New profile (copy of this one)"; clicked => { General.new-profile(); } }
                    Button { text: "Delete"; enabled: Lists.profiles.length > 1; clicked => { General.delete-profile(); } }
                }
                Hint { text: "A profile is the whole layout: apps, names, colours, buttons and Auto-lower. A button can cycle through them."; }
            }
        }

        GroupBox {
            title: "Auto-lower";
            VerticalLayout {
                spacing: 8px;
                CheckBox { text: "Turn some knobs down while others play"; checked <=> General.auto-enabled; }
                if General.auto-enabled: VerticalLayout {
                    spacing: 8px;
                    Label { text: "Turn these down:"; }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        for name[i] in Lists.knob-names: CheckBox {
                            text: name;
                            checked: General.lower[i];
                            toggled => { General.toggle-lower(i); }
                        }
                    }
                    Label { text: "While these play:"; }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        for name[i] in Lists.knob-names: CheckBox {
                            text: name;
                            checked: General.triggers[i];
                            toggled => { General.toggle-trigger(i); }
                        }
                    }
                    CheckBox { text: "Or anyone talks in voice chat (Discord, Steam, TeamSpeak, …)"; checked <=> General.voice-chat; }
                    HorizontalLayout {
                        spacing: 8px;
                        Label { text: "By"; width: 110px; }
                        ComboBox { model: Lists.amounts; current-index <=> General.amount-index; }
                    }
                    CheckBox { text: "Dim their knob lights too"; checked <=> General.auto-dim; }
                }
            }
        }

        GroupBox {
            title: "Popups and lights";
            VerticalLayout {
                spacing: 8px;
                CheckBox { text: "Show popups for knob turns and buttons"; checked <=> General.popups; }
                if General.popups: HorizontalLayout {
                    spacing: 8px;
                    Label { text: "Show them in"; width: 110px; }
                    ComboBox {
                        model: ["Automatic", "Dynamic island (Atoll)", "KDE on-screen display", "Notifications"];
                        current-index <=> General.popup-style;
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Label { text: "LED brightness"; width: 110px; }
                    Slider { minimum: 0; maximum: 100; value <=> General.brightness; }
                    Label { text: round(General.brightness) + "%"; width: 44px; }
                }
                CheckBox { text: "Dim a knob's lights when nothing on it is playing"; checked <=> General.dim-idle; }
                HorizontalLayout {
                    alignment: start;
                    Button { text: "Calibrate LED colours…"; clicked => { General.open-calibration(); } }
                }
            }
        }

        GroupBox {
            title: "Home Assistant";
            VerticalLayout {
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    Label { text: "Address"; width: 110px; }
                    LineEdit { text <=> General.ha-url; placeholder-text: "http://homeassistant.local:8123"; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Label { text: "Access token"; width: 110px; }
                    LineEdit {
                        text <=> General.ha-token;
                        input-type: password;
                        placeholder-text: Lists.home-assistant ? "saved (type to replace)" : "long-lived access token";
                    }
                }
                Hint { text: "Create a token in Home Assistant under your profile → Security → Long-lived access tokens. It's stored in a file only you can read."; }
            }
        }

        GroupBox {
            title: "Updates";
            VerticalLayout {
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    Label { text: "Installed"; width: 110px; }
                    Label { text: General.current-version; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Label { text: "Status"; width: 110px; }
                    Label { text: General.update-status; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    padding-left: 118px;
                    alignment: start;
                    Button {
                        text: General.checking-update ? "Checking..." : "Check for updates";
                        enabled: !General.checking-update && !General.updating;
                        clicked => { General.check-update(); }
                    }
                    if General.update-available: Button {
                        text: General.updating ? "Installing..." : "Install " + General.latest-version;
                        primary: true;
                        enabled: !General.updating;
                        clicked => { General.apply-update(); }
                    }
                }
                if General.update-available: Hint {
                    text: "Downloads the latest release and updates Cranked Audio. Your settings and profiles will be preserved.";
                }
            }
        }

        HorizontalLayout {
            alignment: start;
            Button { text: "Open the settings file"; clicked => { General.edit-file(); } }
        }
    }
}

component GammaSlider inherits HorizontalLayout {
    in property <string> label;
    in property <color> tint;
    in-out property <float> value;
    callback changed();
    spacing: 10px;
    Rectangle {
        width: 14px;
        height: 14px;
        y: (parent.height - self.height) / 2;
        border-radius: 7px;
        background: root.tint;
    }
    Label { text: root.label; width: 60px; }
    Slider {
        minimum: 0.4;
        maximum: 2.5;
        value <=> root.value;
        changed => { root.changed(); }
    }
    Label { text: round(root.value * 100) / 100; width: 44px; }
}

export component CalibrationPage inherits VerticalLayout {
    spacing: 14px;
    alignment: start;
    GroupBox {
        title: "Make dimmed LEDs keep their colour";
        VerticalLayout {
            spacing: 10px;
            Hint { text: "Look at the mixer: every knob now shows its colour three times. Full brightness on the left, dimmer in the middle, dimmest on the right."; }
            Hint { text: "If the dimmer LEDs look like a different colour than the left one, move a slider. Too red? Lower Red. Missing some green? Raise Green. The mixer changes as you move them."; }
            Hint { text: "When all three LEDs on every knob look like the same colour, press Save. Back leaves things as they were."; }
            GammaSlider { label: "Red"; tint: #ff3b30; value <=> General.gamma-red; changed => { General.gamma-changed(); } }
            GammaSlider { label: "Green"; tint: #22c55e; value <=> General.gamma-green; changed => { General.gamma-changed(); } }
            GammaSlider { label: "Blue"; tint: #3b82f6; value <=> General.gamma-blue; changed => { General.gamma-changed(); } }
            HorizontalLayout {
                alignment: start;
                Button {
                    text: "Reset to no correction";
                    clicked => {
                        General.gamma-red = 1.0;
                        General.gamma-green = 1.0;
                        General.gamma-blue = 1.0;
                        General.gamma-changed();
                    }
                }
            }
        }
    }
}

// Settings > Devices: keyboard knobs, MIDI controllers and deej boxes.
export global Devices {
    // one line per configured device
    in property <[string]> summaries;
    // what can be added (from the service)
    in property <[string]> keyboards;
    in property <[string]> serial-ports;
    // MIDI learn: what the user should do, or what was heard
    in property <string> learn-status;
    in property <bool> learned;
    in property <bool> learning;
    in-out property <int> keyboard-index;
    in-out property <int> keyboard-knob;
    in-out property <int> keyboard-step: 2;
    in-out property <bool> keyboard-grab: true;
    in-out property <int> midi-knob;
    in-out property <bool> midi-button;
    in-out property <bool> midi-relative;
    in-out property <int> deej-port;
    in-out property <int> deej-first;
    in-out property <int> deej-count: 3;
    in-out property <bool> deej-invert;
    callback remove(int);
    callback add-keyboard();
    callback learn();
    callback add-midi();
    callback add-deej();
    callback refresh();
}

export component DevicesPage inherits ScrollView {
    VerticalLayout {
        padding: 4px;
        spacing: 14px;
        alignment: start;

        GroupBox {
            title: "Your devices";
            VerticalLayout {
                spacing: 8px;
                for summary[i] in Devices.summaries: HorizontalLayout {
                    spacing: 8px;
                    Label { text: summary; horizontal-stretch: 1; wrap: word-wrap; }
                    Button { text: "Remove"; clicked => { Devices.remove(i); } }
                }
                if Devices.summaries.length == 0: Hint { text: "None yet. The mixer and the on-screen knobs always work; add more controllers below."; }
            }
        }

        GroupBox {
            title: "MIDI controller";
            VerticalLayout {
                spacing: 8px;
                Hint { text: "Click Learn, then move a knob or fader (or press a button or pad) on your controller."; }
                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: Devices.learning ? "Listening…" : "Learn";
                        enabled: !Devices.learning;
                        clicked => { Devices.learn(); }
                    }
                    Label { text: Devices.learn-status; horizontal-stretch: 1; wrap: word-wrap; }
                }
                if Devices.learned: VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        Label { text: "Use it for"; width: 110px; }
                        ComboBox { model: Lists.knob-names; current-index <=> Devices.midi-knob; }
                    }
                    CheckBox { text: "It's a button (press = that knob's button)"; checked <=> Devices.midi-button; }
                    CheckBox { text: "It's an endless knob (it sends turns, not a position)"; checked <=> Devices.midi-relative; enabled: !Devices.midi-button; }
                    HorizontalLayout {
                        alignment: start;
                        Button { text: "Add this control"; clicked => { Devices.add-midi(); } }
                    }
                }
            }
        }

        GroupBox {
            title: "Keyboard knob";
            VerticalLayout {
                spacing: 8px;
                Hint { text: "A volume knob on a keyboard (or anything with volume keys): turning it turns a knob, pressing it is that knob's button."; }
                HorizontalLayout {
                    spacing: 8px;
                    Label { text: "Keyboard"; width: 110px; }
                    ComboBox { model: Devices.keyboards; current-index <=> Devices.keyboard-index; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Label { text: "Turns"; width: 110px; }
                    ComboBox { model: Lists.knob-names; current-index <=> Devices.keyboard-knob; }
                    Label { text: "by"; }
                    SpinBox { minimum: 1; maximum: 20; value <=> Devices.keyboard-step; }
                    Label { text: "% a click"; }
                }
                CheckBox {
                    text: "Take it over (so it doesn't also change the system volume)";
                    checked <=> Devices.keyboard-grab;
                }
                HorizontalLayout {
                    alignment: start;
                    Button {
                        text: "Add keyboard knob";
                        enabled: Devices.keyboards.length > 0;
                        clicked => { Devices.add-keyboard(); }
                    }
                }
            }
        }

        GroupBox {
            title: "deej slider box (Arduino)";
            VerticalLayout {
                spacing: 8px;
                Hint { text: "A DIY slider box that sends its sliders as \"512|1023|0\" lines over USB."; }
                HorizontalLayout {
                    spacing: 8px;
                    Label { text: "Port"; width: 110px; }
                    ComboBox { model: Devices.serial-ports; current-index <=> Devices.deej-port; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Label { text: "Sliders"; width: 110px; }
                    SpinBox { minimum: 1; maximum: 16; value <=> Devices.deej-count; }
                    Label { text: "starting at"; }
                    ComboBox { model: Lists.knob-names; current-index <=> Devices.deej-first; }
                }
                CheckBox { text: "Sliders read backwards"; checked <=> Devices.deej-invert; }
                HorizontalLayout {
                    alignment: start;
                    Button {
                        text: "Add deej box";
                        enabled: Devices.serial-ports.length > 0;
                        clicked => { Devices.add-deej(); }
                    }
                }
            }
        }

        HorizontalLayout {
            alignment: start;
            Button { text: "Look for devices again"; clicked => { Devices.refresh(); } }
        }
    }
}
